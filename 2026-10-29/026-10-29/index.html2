<!DOCTYPE html>

<html lang="en"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1" name="viewport"/><meta content="#f4efec" name="theme-color"/><title>The October 29 Edit</title><style>html,body,#root{margin:0;min-height:100%}body{background:var(--ds-page)}*{box-sizing:border-box}.magazine{color:var(--ds-ink)}.dateline{display:flex;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.09em;font-weight:600;border-top:6px solid var(--ds-ink);padding:16px 0 10px}.magazine>header{margin-bottom:16px}.index-bar{border-top:1px solid var(--ds-ink);border-bottom:1px solid var(--ds-ink);padding:8px 0;display:flex;align-items:center;justify-content:space-between;gap:12px}.index-bar>span{font-size:12px;color:var(--ds-ink-2)}nav{display:flex;gap:8px;flex-wrap:wrap}.edition{scroll-margin-top:20px;padding-top:30px}.edition-top{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.06em;font-weight:600;padding-bottom:10px}.edition-kicker{color:var(--ds-teal);font-weight:600}.lead-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:28px;margin:18px 0 24px}.lead-art{margin:0 0 20px}.lead-art img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover}.lead-art figcaption{font-size:10px;color:var(--ds-ink-2);line-height:16px;padding-top:6px}.story-meta{display:flex;align-items:center;justify-content:space-between;gap:12px}.tag{color:var(--ds-teal);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.story-no{font-size:11px;color:var(--ds-ink-2)}.story h3{font-size:22px;line-height:1.18;letter-spacing:-.025em;font-weight:600;margin:12px 0}.story-hero h3{font-size:31px;line-height:1.08}.dek{font-size:14px;line-height:23px;margin:12px 0 16px;color:var(--ds-ink-2)}.byline{font-size:10px;line-height:17px;color:var(--ds-ink-2);margin-top:14px}.lead-side{border-left:1px solid var(--ds-hairline);padding-left:24px;display:flex;flex-direction:column;gap:28px}.lead-side .story+.story{border-top:1px solid var(--ds-hairline);padding-top:24px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 24px}.grid .story{border-top:2px solid var(--ds-ink);padding-top:16px}.grid .story h3{font-size:20px}.extra{margin-top:32px;border-top:6px solid var(--ds-ink)}.extra-grid{margin-top:20px}.story details{border-top:1px solid var(--ds-hairline);border-bottom:1px solid var(--ds-hairline)}.story summary{list-style:none;cursor:pointer;min-height:44px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:600}.story summary::-webkit-details-marker{display:none}.story summary span{font-size:22px;font-weight:350}.story details[open] summary span{transform:rotate(45deg)}.reading{padding:0 0 16px}.reading p{font-size:15px;line-height:25px;margin:6px 0 20px}.source-label{font-size:10px;letter-spacing:.04em;color:var(--ds-ink-2);margin-bottom:8px}.source-links{display:flex;flex-wrap:wrap;gap:10px 20px;line-height:24px}.source-links a{font-size:13px;min-height:44px;display:inline-flex;align-items:center}.endnote{margin:40px 0 20px;padding:16px 0;border-top:2px solid var(--ds-ink);border-bottom:1px solid var(--ds-hairline);display:flex;justify-content:space-between;align-items:center;gap:12px}.endnote>span{font-size:10px;letter-spacing:.08em;font-weight:600}summary:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--ds-teal);outline-offset:4px}@media(max-width:767px){.index-bar{display:block}.index-bar>span{display:block;padding:6px 0}nav{margin-top:4px}.lead-layout{display:block}.lead-side{border-left:0;padding-left:0;border-top:2px solid var(--ds-ink);padding-top:20px;margin-top:28px;gap:24px}.grid{grid-template-columns:1fr;gap:24px}.story-hero h3{font-size:29px}.story h3,.grid .story h3{font-size:23px}.dateline{font-size:9px;letter-spacing:.035em}.edition{padding-top:24px}.endnote{display:block}.endnote>span{display:block;margin-bottom:8px}.lead-art img{aspect-ratio:3/2}.reading p{font-size:16px;line-height:26px}}@media(min-width:768px){.magazine>header h1{font-size:48px;line-height:1.1}.extra-grid .story:first-child{grid-column:span 2}.extra-grid .story:first-child h3{font-size:29px}}

